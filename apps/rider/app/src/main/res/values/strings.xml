    <string name="setup_note_device_name">The Bluetooth module takes a new name only after it is power-cycled out of data mode.</string>
    <string name="setup_note_walk_owned">Set by the link walk; not editable here.</string>
    <string name="setup_note_motor_method">The firmware currently drives six-step whatever is stored here.</string>
    <string name="setup_note_dead_time">0 = unset. A configured gate group needs it nonzero.</string>
    <string name="setup_note_current_limit">The firmware clamps the stored limit to 1 to 40 A.</string>
    <string name="setup_note_rider_required">Not required: balance engages without a rider, so arming is the engage act and the frame must be held upright when arming. Profile A runs. Any byte but 0 reads as required.</string>
    <string name="setup_note_vbatt_cal">Rail centivolts = count × slope / 10000 + offset. The firmware clamps the slope to 10000 to 32000 and the offset to -500 to 500 at boot.</string>
    <string name="setup_note_axis_role">1 = X, 2 = Y, 3 = Z, 0 = unset (the compiled role). Written only by the orientation presets and rotations above, together with the signs.</string>
    <string name="setup_note_axis_sign">-1, +1, or 0 for unset (runs the firmware fallback for that axis). Every Apply checks the whole map is a rotation.</string>

    <string name="setup_level_title">Set level</string>
    <string name="setup_level_body">Stand the frame level, then set. The trims that zero the current pitch and roll go in the basket; Apply stores them.</string>
    <!-- %1$s pitch, %2$s roll, both in degrees. -->
    <string name="setup_attitude_now">Now: pitch %1$s°, roll %2$s°</string>
    <string name="setup_attitude_none">No attitude from the board yet</string>
    <string name="setup_level_action">Set level from current attitude</string>

    <string name="setup_orientation_title">IMU orientation</string>
    <string name="setup_orientation_body">The rotation between the IMU chip and the body is two fields: the axis roles (which chip axis is up, which measures the pitch rate) and the six signs. Each choice below writes both. Only proper rotations are offered; the board refuses any other frame at boot and does not bring up its IMU.</string>
    <!-- %1$s is the six signs, e.g. [-1, 1, -1, -1, 1, -1]. -->
    <string name="setup_orientation_stored">Stored map: %1$s</string>
    <string name="setup_orientation_stored_unread">Stored map: not read</string>
    <!-- %1$s is the chip axis playing UP, %2$s the one playing PITCH_RATE, e.g. Z and Y. -->
    <string name="setup_orientation_roles">Stored roles: UP = %1$s, PITCH_RATE = %2$s</string>
    <string name="setup_orientation_roles_unread">Stored roles: not read</string>
    <!-- %1$s is a rotation name. -->
    <string name="setup_orientation_runs">Runs as: %1$s</string>
    <string name="setup_orientation_stored_as">Stored as: %1$s. The board runs the stored map from its next power-up, not now.</string>
    <string name="setup_rotation_mixed">a different rotation for accel and gyro</string>
    <string name="setup_rotation_permuted">a frame with permuted axis roles</string>
    <string name="setup_orientation_unset">Unset signs and roles run the firmware fallback.</string>
    <string name="setup_orientation_mirrored">The stored frame is not a proper rotation (mirrored, or an invalid pair of roles). The board refuses it at boot and does not bring up its IMU. Stage a preset or rotation below before it is next powered up.</string>
    <string name="setup_preset_title">Presets</string>
    <string name="setup_preset_stock_flat">Stock flat mount</string>
    <string name="setup_preset_stock_flat_source">Stock flat mount: the firmware\'s compiled reference (signs -1, +1, -1 under roles UP = Z, PITCH_RATE = Y).</string>
    <string name="setup_orientation_rover">No rover presets yet: the specs give the rover\'s on-edge axis roles but not its per-wall signs, which are to be derived from the rover\'s mechanical model.</string>
    <string name="setup_rotation_title">Flat-mount rotations</string>
    <string name="setup_rotation_identity">Chip axes are board axes</string>
    <string name="setup_rotation_x">Half turn about X</string>
    <string name="setup_rotation_y">Half turn about Y (the firmware fallback)</string>
    <string name="setup_rotation_z">Half turn about Z</string>

    <string name="setup_check_title">Rotation check</string>
    <string name="setup_check_body">Run on the assembled frame, after the power-cycle that applies the orientation. A pass means the pitch and roll the board reports agree with its map. The up-axis gravity sign and the pitch-rate sign are not sent over Bluetooth; they need the bench check.</string>
    <string name="setup_check_level">Check level</string>
    <string name="setup_check_lean">Check forward lean</string>
    <string name="setup_check_level_hint">Frame level: pitch and roll within 10° of zero.</string>
    <string name="setup_check_lean_hint">Hold the frame leaning forward more than 10°: pitch reads negative.</string>
    <string name="setup_check_pass">Pass</string>
    <string name="setup_check_fail">Fail</string>
    <string name="setup_check_inconclusive">Lean further</string>
    <string name="setup_check_not_run">Not run</string>
    <string name="setup_check_blocked">The orientation is pending or staged. Apply it and power-cycle the board first.</string>

    <string name="setup_notice_armed">Armed: nothing was changed. Disarm on the Ride tab to edit.</string>
    <!-- %1$s is a field label. -->
    <string name="setup_notice_refused_armed">The board refused %1$s: it is armed.</string>
    <string name="setup_notice_refused_bad">The board refused %1$s as malformed.</string>
    <string name="setup_notice_refused_unknown">The board does not know %1$s.</string>
    <string name="setup_notice_refused_type">The board stores %1$s as a different type.</string>
    <string name="setup_notice_refused_store">The board could not store %1$s (flash full or failed).</string>
    <!-- %1$s field label, %2$s value written, %3$s value the board echoed. -->
    <string name="setup_notice_mismatch">%1$s: wrote %2$s but the board stores %3$s. Read again to see what it holds.</string>
    <string name="setup_notice_unanswered">%1$s: no answer from the board. It was read again to see what it holds.</string>
    <string name="setup_notice_garbled">%1$s: the answer from the board could not be understood.</string>
    <string name="setup_notice_not_attached">No board is attached, so nothing was sent.</string>
    <string name="setup_notice_not_a_sign">A sign must be -1, 0 (unset) or +1. Nothing was written.</string>
    <string name="setup_notice_accel_mirrored">The accelerometer signs would form a mirrored frame (determinant -1). Nothing was written.</string>
    <string name="setup_notice_gyro_mirrored">The gyro signs would form a mirrored frame (determinant -1). Nothing was written.</string>
    <string name="setup_notice_frame_unknown">A sign or axis role is neither stored nor staged, so the frame cannot be checked. Read again first.</string>
    <string name="setup_notice_roles">The axis roles would name one chip axis twice or a value outside 0 to 3. Nothing was written.</string>
    <string name="setup_notice_out_of_range">%1$s does not take that value.</string>
    <string name="setup_notice_no_telemetry">No attitude has arrived from the board yet.</string>
    <string name="setup_notice_not_read">The stored values this needs have not been read.</string>
    <string name="setup_notice_not_applied">The board is running a value the app cannot know: a field this depends on is pending or staged. Apply and power-cycle first.</string>
    <!-- %1$s is the previous board's address. -->
    <string name="setup_notice_board_changed">A different board attached. The edits for board %1$s were dropped.</string>
</resources>
