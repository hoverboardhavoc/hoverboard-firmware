<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Hoverboard Remote</string>

    <!-- Permission rationale -->
    <string name="permission_title">Bluetooth Permission</string>
    <string name="permission_description">Hoverboard Remote needs Bluetooth access to scan for and connect to your board. This is required to drive the vehicle. No location data is collected.</string>
    <string name="permission_continue">Continue</string>
    <string name="permission_skip">Skip</string>

    <!-- Connect screen -->
    <string name="connect_title">Hoverboard Remote</string>
    <!-- %1$s is the configured board name (LinkSettings.deviceName). -->
    <string name="connect_scan">Scan for %1$s</string>
    <string name="connect_stop_scan">Stop scan</string>
    <string name="connect_connect">Connect</string>
    <string name="connect_disconnect">Disconnect</string>
    <string name="connect_status_idle">Not connected</string>
    <string name="connect_status_scanning">Scanning for %1$s…</string>
    <string name="connect_status_found">Found %1$s</string>
    <string name="connect_status_connecting">Connecting…</string>
    <string name="connect_status_attaching">Attaching to the board…</string>
    <string name="connect_status_connected">Connected</string>
    <string name="connect_status_disconnected">Disconnected</string>
    <string name="connect_status_attach_failed">The board would not attach. It may be armed; power-cycle it and try again.</string>
    <string name="connect_status_error">Connection error</string>
    <string name="connect_no_device">No %1$s found yet</string>
    <string name="connect_device_name_label">Board name</string>

    <!-- Control screen -->
    <string name="control_title">Control</string>
    <string name="throttle_hint_armed">Hold the throttle to drive · release to stop</string>
    <string name="throttle_hint_disarmed">Tap ARM to enable the motors</string>

    <!-- Arm control. The one tappable arm surface; there is no separate armed banner. -->
    <string name="arm_action">TAP TO ARM</string>
    <string name="arm_disarm_action">ARMED · TAP TO DISARM</string>
    <string name="arm_unavailable">RELEASE THROTTLE TO ARM</string>
    <string name="throttle_label_forward">FWD</string>
    <string name="throttle_label_reverse">REV</string>
    <string name="throttle_label_zero">0</string>
    <string name="throttle_engaged">ENGAGED</string>

    <!-- Bench affordance: stand in for foot pads the board does not have wired. Debug builds
         only, and a long press rather than a tap, so the label has to say so. -->
    <string name="sim_rider_label">SIMULATE RIDER · HOLD</string>
    <string name="sim_rider_on">ON</string>
    <string name="sim_rider_off">OFF</string>
    <string name="throttle_idle">IDLE — STOPPED</string>

    <!-- Telemetry -->
    <string name="telemetry_title">Telemetry</string>
    <string name="telemetry_link_a">Wheel A</string>
    <string name="telemetry_link_b">Wheel B</string>
    <string name="telemetry_link_alive">LINK</string>
    <string name="telemetry_link_dead">DOWN</string>
    <string name="telemetry_battery">Battery</string>
    <string name="telemetry_battery_value">%1$.1f V</string>
    <string name="telemetry_battery_percent">%1$d%%</string>
    <string name="telemetry_battery_low">LOW BATTERY</string>
    <string name="telemetry_speed">Speed</string>
    <string name="telemetry_speed_value">%1$d</string>
    <string name="telemetry_throttle">Throttle</string>
    <string name="telemetry_throttle_value">%1$d%%</string>
    <string name="telemetry_pitch">Pitch</string>
    <string name="telemetry_roll">Roll</string>
    <string name="telemetry_angle_value">%1$.1f\u00B0</string>
    <!-- The board's own state bits. RIDER is drawn lit or dim; the alarms only when they assert. -->
    <string name="telemetry_chip_rider">RIDER</string>
    <string name="telemetry_chip_lockdown">LOCKDOWN</string>
    <string name="telemetry_chip_fault_stop">FAULT · STOP ALL</string>
    <!-- %1$d is the FAULT PDU's code byte (state::fault codes, e.g. 0x11 overcurrent). -->
    <string name="telemetry_chip_fault_code">FAULT %1$d</string>
    <!-- %1$d is the CYCLIC_STATE latched fault level. -->
    <string name="telemetry_chip_fault_level">FAULT LEVEL %1$d</string>

    <!-- Shown whenever no fault is asserting, so silence does not read as "healthy". It is worded
         as a statement about the firmware this app was BUILT FOR, not about the board in front of
         it: the app has no way to ask a board whether it can report faults, so once a producer
         ships this line is false and has to be deleted by hand. Tracked in specs/todo.md part 5. -->
    <string name="telemetry_fault_unreported">Fault reporting is not implemented in the firmware this app was built for, so this cannot warn you.</string>

    <!-- Battery: the firmware sends a fixed constant, so the reading is labelled, not trusted. -->
    <string name="telemetry_battery_placeholder">PLACEHOLDER</string>
    <string name="telemetry_battery_placeholder_note">Not measured. The firmware sends a fixed 36.0 V; no board senses its pack yet.</string>

    <string name="telemetry_no_data">Waiting for telemetry…</string>
    <string name="telemetry_disconnected">Disconnected — reconnect to drive</string>
</resources>
