# Specs and documents: kept LOCAL during the deliberate rebuild (not committed yet).
# specs/    = new, going-forward specs (the roadmap + per-layer specs as we build them)
# old-specs/ = the prior design docs, kept for reference
/specs/
/old-specs/

# Rust build output (each workspace's, and any nested crate that was built in-place)
**/target/

# Flashable ELF artifacts staged for the Pi (built locally, not for publish)
/motorcontroller/firmware/dist/

# Local reference: MCU manuals + bench notes (not for publish)
/reference/

# The bridge's Wi-Fi credentials were a build-time file; they are store fields now
# (specs/bridge-onboarding.md), and the ignore stays so an old copy never reaches a commit.
bridge/.wifi.env
# A settings file holding Wi-Fi credentials (wifi.pass) is named wifi*.json and never committed.
wifi*.json
__pycache__/
